# Copie ce fichier en ".env" puis colle ta clé API Anthropic (https://console.anthropic.com/settings/keys).
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).
ANTHROPIC_API_KEY=

# Facultatif
# PORT=3000
# NETSCAN_MODEL=claude-opus-5-5
# Effort de réflexion : low | medium | high | xhigh | max (plus haut = plus précis, plus lent et plus cher)
# NETSCAN_EFFORT=medium
